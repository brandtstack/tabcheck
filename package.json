{
  "name": "tabcheck",
  "version": "0.1.0",
  "description": "Does your favicon actually show up on a browser tab? Checks an SVG icon against real light and dark tabs in Chromium, then exports the whole icon set.",
  "keywords": ["favicon", "icon", "pwa", "maskable", "contrast", "dark-mode", "cli", "ci"],
  "license": "MIT",
  "author": "Adrian Brandt (https://brandtstack.com)",
  "homepage": "https://github.com/brandtstack/tabcheck#readme",
  "repository": { "type": "git", "url": "git+https://github.com/brandtstack/tabcheck.git" },
  "bugs": "https://github.com/brandtstack/tabcheck/issues",
  "type": "module",
  "bin": { "tabcheck": "dist/bin.js" },
  "exports": { ".": "./dist/index.js" },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
